/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Minimal test: standard mode, one synthetic study with four mzML runs
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nextflow run lifs-tools/msdeposit -profile test,docker --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Standard mode with synthetic mzML (tests/data/standard)'

    input                  = "${projectDir}/tests/data/standard/runs.csv"
    assays                 = "${projectDir}/tests/data/standard/assays.csv"
    samples                = "${projectDir}/tests/data/standard/samples.csv"
    studies                = "${projectDir}/tests/data/standard/studies.yml"
    contacts               = "${projectDir}/tests/data/standard/contacts.csv"
    features               = "${projectDir}/tests/data/standard/features.csv"
    values                 = "${projectDir}/tests/data/standard/values.csv"
    study_variables        = "${projectDir}/tests/data/standard/study_variables.csv"
    study_variable_members = "${projectDir}/tests/data/standard/members.csv"
    mztab_versions         = '2.0.0-M,2.1.0-M'
}
