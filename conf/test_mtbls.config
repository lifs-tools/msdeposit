/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Real-data test: sensitive mode on three runs of the public MetaboLights studies MTBLS1381 and MTBLS1382
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    tests/data/mtbls/fetch.sh     # downloads and verifies the files (about 53 MB)
    nextflow run lifs-tools/msdeposit -profile test_mtbls,docker --outdir <OUTDIR> --private_outdir <PRIVATE>

    SRM: two SCIEX QTRAP 6500 runs (MTBLS1381), given as the public mzML (format mzml)
    DIA: one Thermo Q Exactive HF .raw file (MTBLS1382), converted with ThermoRawFileParser
    No ProteoWizard vendor-reader image is needed. For the msconvert path use
    --input tests/data/mtbls/runs_vendor.csv --thermo_converter pwiz --accept_vendor_licenses
    (after tests/data/mtbls/fetch.sh --vendor). See tests/data/mtbls/README.md.
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'MetaboLights test profile'
    config_profile_description = 'Sensitive mode with runs of MTBLS1381 (SCIEX mzML) and MTBLS1382 (Thermo raw)'

    sensitive_data         = true
    // test runners launch from their own directories; real sensitive runs keep the guard on (design §9)
    enforce_private_launch = false
    thermo_converter       = 'thermorawfileparser'

    input                  = "${projectDir}/tests/data/mtbls/runs.csv"
    assays                 = "${projectDir}/tests/data/mtbls/assays.csv"
    samples                = "${projectDir}/tests/data/mtbls/samples.csv"
    studies                = "${projectDir}/tests/data/mtbls/studies.yml"
    contacts               = "${projectDir}/tests/data/mtbls/contacts.csv"
    // words of the original folder names that also describe the study (see README.md, "False positives")
    allowlist              = "${projectDir}/tests/data/mtbls/allowlist.txt"
}
