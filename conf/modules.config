/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Per-module options
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Publishing is defined in one place, the workflow `output {}` block in main.nf (public outdir vs
    private_outdir, design §9). Processes therefore have no publishDir.
    Containers run without network (design §9.3) except the checks (C7: the mzTab-M 2.0 semantic pass
    looks up CV terms on OLS) and the lipid annotation with --allow_network.
----------------------------------------------------------------------------------------
*/

process {
    withLabel: 'msdeposit_tools' {
        containerOptions = { workflow.containerEngine == 'docker' ? '--network none' : '' }
    }

    withName: 'CHECK' {
        containerOptions = ''
    }

    withName: 'LIPID_ANNOTATE' {
        containerOptions = { !params.allow_network && workflow.containerEngine == 'docker' ? '--network none' : '' }
    }

    // Wine prefix in the pwiz image is root-owned: run as root (outputs are chowned back by the module)
    withName: 'PWIZ_MSCONVERT' {
        containerOptions = { workflow.containerEngine == 'docker' ? '-u 0:0 --network none' : '' }
        ext.args = { [
            waters    : '--ignoreCalibrationScans',         // drop the lock-mass function
            agilent   : '--combineIonMobilitySpectra',      // no-op without ion mobility
            bruker_tdf: '--combineIonMobilitySpectra',
        ][meta.vendor] ?: '' }
        maxForks = 8
        errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'terminate' }
        maxRetries = 2
        time = { 6.h * task.attempt }   // Agilent ion-mobility files take ~3 h each
    }

    withName: 'THERMORAWFILEPARSER' {
        ext.prefix = { meta.conv }
        ext.args = '--format 2'           // indexed mzML, vendor peak picking (default)
        containerOptions = { workflow.containerEngine == 'docker' ? '--network none' : '' }
    }

    withName: 'DEPOSIT_REPORT_PUBLIC' {
        ext.args = '--public deposit_report.html'
    }

    withName: 'DEPOSIT_REPORT_PRIVATE' {
        ext.args = '--private deposit_report.private.html'
    }
}
