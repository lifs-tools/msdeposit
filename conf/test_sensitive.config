/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Sensitive-mode test: synthetic mzML with planted identifiers (tests/data/sensitive)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nextflow run lifs-tools/msdeposit -profile test_sensitive,docker --outdir <OUTDIR> --private_outdir <PRIVATE>
    The study passes only because the anonymisation removes every planted identifier; with
    --mzml_body_rewrite false it must be blocked by S2.
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Sensitive test profile'
    config_profile_description = 'Sensitive mode with synthetic mzML and planted identifiers (tests/data/sensitive)'

    sensitive_data         = true
    // test runners launch from their own directories; real sensitive runs keep the guard on (design §9)
    enforce_private_launch = false

    input                  = "${projectDir}/tests/data/sensitive/runs.csv"
    assays                 = "${projectDir}/tests/data/sensitive/assays.csv"
    samples                = "${projectDir}/tests/data/sensitive/samples.csv"
    studies                = "${projectDir}/tests/data/sensitive/studies.yml"
    contacts               = "${projectDir}/tests/data/sensitive/contacts.csv"
    features               = "${projectDir}/tests/data/sensitive/features.csv"
    values                 = "${projectDir}/tests/data/sensitive/values.csv"
    study_variables        = "${projectDir}/tests/data/sensitive/study_variables.csv"
    study_variable_members = "${projectDir}/tests/data/sensitive/members.csv"
    denylist               = "${projectDir}/tests/data/sensitive/denylist.txt"
}
