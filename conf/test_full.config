/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Full test: the standard test data with every optional step switched on
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nextflow run lifs-tools/msdeposit -profile test_full,docker --outdir <OUTDIR>
    Real vendor data (MTBLS1381, MTBLS1382) is tested by -profile test_mtbls (conf/test_mtbls.config).
----------------------------------------------------------------------------------------
*/

includeConfig 'test.config'

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Standard test data with lipid annotation and both mzTab-M versions'

    lipid_annotation           = 'goslin'
    mztab_versions             = '2.0.0-M,2.1.0-M'
    fail_on_validation_errors  = false
}
